# Copy to .env and adjust. `docker compose up -d` reads it automatically.

# --- Web UI and API ---------------------------------------------------------------
# The port the web UI and the API are served on.
SCRAPEMM_PORT=8080

# The bearer token every API call and the web UI must present. Leave empty and the
# server generates one on first start and prints it to the log.
SCRAPEMM_API_KEY=

# Set to 1 when a reverse proxy terminates HTTPS in front of the server. Without it,
# a server reachable beyond localhost warns at startup -- secrets typed into the web
# UI would otherwise travel unencrypted.
SCRAPEMM_BEHIND_TLS=

SCRAPEMM_LOG_LEVEL=INFO
SCRAPEMM_MAX_CONCURRENCY=40

# --- Storage ----------------------------------------------------------------------
# Where the server keeps its state (secrets, blacklist, job history, browser profile).
SCRAPEMM_CONFIG_DIR=./data/config

# The ezMM media directory the retrieved images and videos go to. Give an ABSOLUTE
# path -- ideally the one your clients' EZMM points at -- and Python clients on this
# machine use the files where they lie instead of downloading a copy of each.
# Example: /srv/scrapemm/media   (Windows: C:/scrapemm/media)
SCRAPEMM_MEDIA_DIR=./data/media

# --- Secrets encryption -----------------------------------------------------------
# Optional. The server generates a key into its config directory on first start and
# nobody has to manage it. Set this only if you want the key out of the volume (for
# instance from a Docker secret).
SCRAPEMM_MASTER_KEY=

# --- Browser ----------------------------------------------------------------------
# The virtual screen that the headed browser and the Archive.today CAPTCHA panel use.
SCRAPEMM_SCREEN_SIZE=1440x900x24
SCRAPEMM_SHM_SIZE=1gb

# --- Firecrawl --------------------------------------------------------------------
# Leave this profile enabled to have compose run Firecrawl for you. Further instances
# can be added in the web UI under Settings.
COMPOSE_PROFILES=firecrawl
FIRECRAWL_VERSION=2.11.399-production
FIRECRAWL_PLAYWRIGHT_VERSION=latest
FIRECRAWL_WORKERS=8
FIRECRAWL_DB_PASSWORD=firecrawl
